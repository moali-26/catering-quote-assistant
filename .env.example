# Python server only. Copy the connection string from Supabase > Connect.
# Never use a NEXT_PUBLIC_ prefix or commit a real password.
QUOTE_DATABASE_URL=
# Supabase Auth (Settings > API Keys: the publishable key, never the secret key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web app (see docs/app.md). APP_ENV=production hides /docs.
APP_ENV=development
APP_DATASET=sample
# Supabase Auth user ID(s) of the business owner, comma-separated (server-side role, never chosen at sign-up).
OWNER_USER_IDS=
# Local preview without Supabase: AUTH_BACKEND=memory (refused when APP_ENV=production).
AUTH_BACKEND=
# Claude API key for the chat service. Never commit a real value.
ANTHROPIC_API_KEY=
