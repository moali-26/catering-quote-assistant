# Python server only. Copy the connection string from Supabase > Connect.
# Never use a NEXT_PUBLIC_ prefix or commit a real password.
QUOTE_DATABASE_URL=
# Supabase Auth (Settings > API Keys: the publishable key, never the secret key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web app (see docs/app.md). APP_ENV=production hides /docs.
APP_ENV=development
APP_DATASET=sample
# Supabase Auth user ID(s) of the business owner, comma-separated (server-side role, never chosen at sign-up).
OWNER_USER_IDS=
# Local preview without Supabase: AUTH_BACKEND=memory (refused when APP_ENV=production).
AUTH_BACKEND=
# Chat model. LLM_PROVIDER=anthropic (default when ANTHROPIC_API_KEY is set), openai,
# or scripted (local preview without any API key; refused in production).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. Set to none for models that refuse tools with reasoning on (e.g. gpt-6-luna).
OPENAI_REASONING_EFFORT=
# Owner software plan (Stripe TEST mode only; live keys are refused). See docs/billing.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
